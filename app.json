{
  "expo": {
    "name": "Tiny Talkers",
    "slug": "tiny-talkers",
    "version": "1.0.0",
    "description": "Alphabet and speaking practice for kids in English, Hindi, and Marathi.",
    "scheme": "tiny-talkers",
    "primaryColor": "#a78bfa",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0618"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandarvyas.tinytalkers",
      "infoPlist": {
        "CFBundleDisplayName": "Tiny Talkers",
        "NSSpeechRecognitionUsageDescription": "Allow Tiny Talkers to recognize speech so we can cheer you on.",
        "NSMicrophoneUsageDescription": "Allow Tiny Talkers to use the microphone for pronunciation practice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a0f3c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mandarvyas.tinytalkers",
      "versionCode": 1,
      "privacyPolicy": "https://keeplay20.github.io/tiny-talkers/privacy.html"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Tiny Talkers to use the microphone for pronunciation practice.",
          "speechRecognitionPermission": "Allow Tiny Talkers to recognize speech so we can cheer you on."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f7fdf0c3-14f0-461c-ae3e-9bd1023c52b4"
      },
      "feedbackFormUrl": "https://docs.google.com/forms/d/e/1FAIpQLSd8_LfNG_WEIWQSeyd4IlLugLh3ZNsNHAyHDIyKm_Bou6Nqhg/viewform",
      "privacyPolicyUrl": "https://keeplay20.github.io/tiny-talkers/privacy.html"
    }
  }
}
